# ==========================================
# Inbox Quest AI - Environment Configuration
# ==========================================

# Server port (assigned automatically by Google Cloud Run)
PORT=8080
NODE_ENV=development

# Google Gemini API Key (@google/genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth 2.0 Credentials (Gmail API)
# Minimum scope needed: https://www.googleapis.com/auth/gmail.modify
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Session Secret (used to sign session cookies)
SESSION_SECRET=inbox_quest_super_secret_session_encryption_key_change_me
CLIENT_URL=http://localhost:5173
