# ==========================================
# Inbox Quest AI - Server Environment Variables
# ==========================================

# Port (default 8080 locally; Vercel assigns its own runtime port)
PORT=

# Environment mode ('development' or 'production')
NODE_ENV=

# Production client URL for CORS and OAuth redirects
# e.g. https://inbox-quest-ai-six.vercel.app
CLIENT_URL=

# Google Gemini API (@google/genai)
GEMINI_API_KEY=
GEMINI_MODEL=

# Google OAuth 2.0 Credentials (Gmail API)
# Get from Google Cloud Console > APIs & Services > Credentials
# Redirect URI MUST be: https://inbox-quest-ai-six.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Upstash Redis (Serverless persistent session & token storage)
# Get from Upstash Console (https://console.upstash.com/redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session Secret (Optional - for cookie signing)
SESSION_SECRET=
