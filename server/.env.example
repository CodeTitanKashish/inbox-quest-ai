# ==========================================
# Inbox Quest AI - Server Environment Variables
# ==========================================

# Port (default 8080 locally; Vercel assigns its own runtime port)
PORT=

# Environment mode ('development' or 'production')
NODE_ENV=

# Production client URL for CORS and OAuth redirects
# e.g. https://inbox-quest-ai-six.vercel.app
CLIENT_URL=

# Google Gemini API (@google/genai)
GEMINI_API_KEY=
GEMINI_MODEL=

# Google OAuth 2.0 Credentials (Optional - for live Gmail login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Session Secret (Optional - for cookie signing)
SESSION_SECRET=
